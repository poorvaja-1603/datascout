# Local defaults are non-production. Never put real credentials in this file.
LLM_PROVIDER=fake
AWS_REGION=us-east-1
GEMINI_MODEL_ID=gemini-3.8-flash
GEMINI_API_KEY=
OLLAMA_MODEL_ID=qwen3:8b
# Local Ollama uses no API key; remote Ollama is intentionally not supported.
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_SAFETY_MODEL_ID=
LLM_ENABLED=false
LLM_MAX_CONCURRENT=4
LLM_PER_USER_DAILY_LIMIT=30
LLM_GLOBAL_DAILY_LIMIT=300
LLM_TIMEOUT_MS=120000
LLM_MAX_OUTPUT_TOKENS=1024
# Optional outage fallback. Only gemini/ollama are allowed.
LLM_FALLBACK_PROVIDER=
GEMINI_FALLBACK_MODEL_ID=
OLLAMA_FALLBACK_MODEL_ID=
# Optional outage fallback. Only gemini/ollama are allowed.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Use the base URL for the Langfuse region hosting this project.
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENVIRONMENT=dev
LANGFUSE_RELEASE=0.1.0

# Backend & AWS SAM Configuration
ENVIRONMENT=dev
CORS_ALLOWED_ORIGIN=*
LOG_LEVEL=INFO

# Local development only. Deployed Lambda reads service tokens by ARN from Secrets Manager.
DATAGOVIN_API_KEY=
HUGGINGFACE_API_TOKEN=
# Kaggle API token — get one at https://www.kaggle.com/settings (API -> Create New Token)
KAGGLE_API_TOKEN=

# AWS Deployed Resource Identifiers (Populated from SAM outputs)
RESULTS_TABLE_NAME=
DATASETS_TABLE_NAME=
SNAPSHOTS_BUCKET_NAME=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
API_ENDPOINT=
