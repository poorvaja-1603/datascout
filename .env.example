# ============================================================
# DataScout – Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env or put real secrets here.
# ============================================================

# ------------------------------------------------------------
# AWS Credentials
# ------------------------------------------------------------
# Standard region for all AWS SDK calls. AWS Academy only supports us-east-1.
AWS_REGION=us-east-1

# --- AWS Academy Learner Lab (temporary, rotated each session) ---
# Open your Learner Lab → click "AWS Details" → "Show" next to AWS CLI.
# These three values change every time you start a new lab session.
# Do NOT hardcode these anywhere other than your local .env.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Standard/SSO credentials (non-Academy accounts) ---
# If you use a named AWS CLI profile (aws configure / SSO), set it here.
# Leave blank when using the AWS Academy keys above.
AWS_PROFILE=

# ------------------------------------------------------------
# LLM Provider  (currently disabled — set LLM_ENABLED=false)
# ------------------------------------------------------------
# Options: fake | cassette
# Do NOT set "gemini" or "bedrock" — neither is available in AWS Academy.
LLM_PROVIDER=fake
LLM_ENABLED=false
LLM_MAX_CONCURRENT=4
LLM_PER_USER_DAILY_LIMIT=30
LLM_GLOBAL_DAILY_LIMIT=300
LLM_TIMEOUT_MS=120000
LLM_MAX_OUTPUT_TOKENS=1024

# Gemini — only used when LLM_PROVIDER=gemini (not AWS Academy)
GEMINI_MODEL_ID=gemini-2.5-flash
GEMINI_API_KEY=

# Ollama — only used when LLM_PROVIDER=ollama (local only)
OLLAMA_MODEL_ID=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Safety / moderation model (leave blank to disable)
LLM_SAFETY_MODEL_ID=

# ------------------------------------------------------------
# Observability — Langfuse (optional)
# ------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Base URL for your Langfuse region, e.g. https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENVIRONMENT=dev
LANGFUSE_RELEASE=0.1.0

# ------------------------------------------------------------
# Backend Runtime
# ------------------------------------------------------------
ENVIRONMENT=dev
CORS_ALLOWED_ORIGIN=*
LOG_LEVEL=INFO

# ------------------------------------------------------------
# External API Credentials  (local dev only)
# Deployed Lambda reads these from AWS Secrets Manager by ARN,
# NOT from environment variables. Fill in here only for local runs.
# ------------------------------------------------------------
# data.gov.in API key — free, get one at https://data.gov.in/user/register
DATAGOVIN_API_KEY=
# Hugging Face token — free, get one at https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=

# ------------------------------------------------------------
# AWS SAM Stack Outputs
# Run after `sam deploy` to populate these:
#   aws cloudformation describe-stacks \
#     --stack-name datascout-backend-dev \
#     --region us-east-1 \
#     --query "Stacks[0].Outputs" --output table
# ------------------------------------------------------------
RESULTS_TABLE_NAME=
DATASETS_TABLE_NAME=
CATALOG_TABLE_NAME=
SNAPSHOTS_BUCKET_NAME=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
API_ENDPOINT=

# ------------------------------------------------------------
# Secrets Manager ARNs  (used only in sam deploy --parameter-overrides)
# Copy the ARN printed by `aws secretsmanager create-secret` here for reference.
# These are NOT read at runtime by the app — pass them to SAM only.
# ------------------------------------------------------------
DATAGOVIN_API_KEY_SECRET_ARN=
HUGGINGFACE_API_TOKEN_SECRET_ARN=
