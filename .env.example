# Local defaults are non-production. Never put real credentials in this file.
LLM_PROVIDER=fake
AWS_REGION=ap-south-1
# Set AWS credentials with `aws sso login` or an AWS profile; do not put access keys here.
AWS_PROFILE=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Use the base URL for the Langfuse region hosting this project.
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENVIRONMENT=dev
LANGFUSE_RELEASE=0.1.0

# Backend & AWS SAM Configuration
ENVIRONMENT=dev
CORS_ALLOWED_ORIGIN=*
LOG_LEVEL=INFO

# Local development only. Deployed Lambda reads service tokens by ARN from Secrets Manager.
DATAGOVIN_API_KEY=
HUGGINGFACE_API_TOKEN=

# AWS Deployed Resource Identifiers (Populated from SAM outputs)
RESULTS_TABLE_NAME=
DATASETS_TABLE_NAME=
SNAPSHOTS_BUCKET_NAME=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
API_ENDPOINT=
