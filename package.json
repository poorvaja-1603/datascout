{
  "name": "datascout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "contracts",
    "packages/ai",
    "packages/verify",
    "packages/observability",
    "packages/connectors",
    "backend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:openapi": "redocly lint contracts/openapi.yaml --config contracts/redocly.yaml",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "mock": "npm run mock --workspace=@datascout/contracts",
    "langfuse:smoke": "npm run smoke --workspace=@datascout/observability",
    "validate:corpus": "python evals/validate_dataset.py",
    "eval:safety": "tsx evals/safety-runner.ts",
    "eval:safety:triage": "tsx evals/triage-runner.ts",
    "eval:verdict": "tsx evals/verdict-runner.ts",
    "eval:grounding": "tsx evals/grounding-runner.ts",
    "eval:retrieval": "tsx evals/retrieval-runner.ts",
    "eval:cassettes": "tsx evals/generate-dev-cassettes.ts",
    "gemini:connectivity": "node --env-file-if-exists=evals/.env evals/gemini-connectivity.mjs --confirm-connectivity-check",
    "langfuse:dataset": "node --env-file-if-exists=evals/.env evals/upload-langfuse-dataset.mjs",
    "langfuse:experiment": "node --env-file-if-exists=evals/.env evals/run-langfuse-experiment.mjs",
    "langfuse:dashboard": "node --env-file-if-exists=evals/.env evals/create-langfuse-dashboard.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@redocly/cli": "2.71.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "eslint": "10.13.0",
    "esbuild": "0.28.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
