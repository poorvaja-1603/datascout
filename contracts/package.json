{
  "name": "@datascout/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && npm run export:json-schema",
    "export:json-schema": "tsx scripts/export-json-schema.ts",
    "test": "vitest run && tsx scripts/validate-corpus-contract.mjs",
    "lint": "eslint . --ext .ts,.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
