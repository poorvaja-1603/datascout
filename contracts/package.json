{
  "name": "@datascout/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && npm run export:json-schema && npm run bundle:openapi",
    "export:json-schema": "tsx scripts/export-json-schema.ts",
    "bundle:openapi": "redocly bundle openapi.yaml --config redocly.yaml --output dist/openapi.yaml",
    "test": "npm run bundle:openapi && vitest run && tsx scripts/validate-corpus-contract.mjs && tsx scripts/check-sam-api-contract.ts",
    "lint": "eslint . --ext .ts,.js && redocly lint openapi.yaml --config redocly.yaml",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  }
}
