{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requirement_id": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": [
        "topic",
        "geography",
        "time_coverage",
        "minimum_records",
        "feature",
        "target",
        "constraint",
        "preference"
      ]
    },
    "value": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "number" }]
    },
    "unit": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "priority": { "type": "string", "enum": ["required", "preferred"] },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "source_span": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "end": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "text": { "type": "string", "minLength": 1 }
          },
          "required": ["start", "end", "text"],
          "additionalProperties": false,
          "description": "Zero-based, end-exclusive UTF-16 offsets into the original query."
        },
        { "type": "null" }
      ]
    }
  },
  "required": [
    "requirement_id",
    "type",
    "value",
    "unit",
    "priority",
    "aliases",
    "source_span"
  ],
  "additionalProperties": false
}
