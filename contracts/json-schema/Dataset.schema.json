{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "source": { "type": "string", "minLength": 1 },
    "source_url": {
      "anyOf": [{ "type": "string", "format": "uri" }, { "type": "null" }]
    },
    "title": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "description": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "license": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "access_type": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "api_endpoint": {
      "anyOf": [{ "type": "string", "format": "uri" }, { "type": "null" }]
    },
    "file_formats": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "record_count": {
      "anyOf": [
        { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        { "type": "null" }
      ]
    },
    "columns": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "geography": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "time_coverage": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "last_updated": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        { "type": "null" }
      ]
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "raw_snapshot_key": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "verification_level": {
      "type": "string",
      "enum": ["metadata_only", "sample_checked", "full_dataset"]
    },
    "provenance": {
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "source_field_path": { "type": "string", "minLength": 1 },
          "retrieved_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": ["source_field_path", "retrieved_at"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "dataset_id",
    "source",
    "source_url",
    "title",
    "description",
    "license",
    "access_type",
    "api_endpoint",
    "file_formats",
    "record_count",
    "columns",
    "geography",
    "time_coverage",
    "tags",
    "last_updated",
    "retrieved_at",
    "raw_snapshot_key",
    "verification_level",
    "provenance"
  ],
  "additionalProperties": false
}
