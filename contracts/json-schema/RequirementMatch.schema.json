{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requirement_id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["PASS", "PARTIAL", "FAIL", "UNKNOWN"]
    },
    "reason": { "type": "string", "minLength": 1 },
    "evidence_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "verification_level": {
      "type": "string",
      "enum": ["metadata_only", "sample_checked", "full_dataset"]
    },
    "measured_value": { "$ref": "#/$defs/__schema0" }
  },
  "required": [
    "requirement_id",
    "status",
    "reason",
    "evidence_ids",
    "verification_level"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/__schema0" } },
        {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "$ref": "#/$defs/__schema0" }
        }
      ]
    }
  }
}
